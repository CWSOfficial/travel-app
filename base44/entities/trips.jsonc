{
  "name": "trips",
  "description": "Each trip belongs to one user. Status field uses controlled vocabulary. Coordinates enable map features and future geospatial DB indexing.",
  "type": "object",
  "properties": {
    "id_uuid": {
      "type": "string",
      "description": "Primary key in UUID format"
    },
    "user_id": {
      "type": "string",
      "description": "Foreign key referencing users.id"
    },
    "trip_name": {
      "type": "string",
      "description": "Human-readable trip name, e.g. Tokyo Spring 2025"
    },
    "destination_city": {
      "type": "string",
      "description": "City of the trip destination"
    },
    "destination_country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code, e.g. JP, GB"
    },
    "destination_lat": {
      "type": "number",
      "description": "Latitude coordinate of the destination"
    },
    "destination_lng": {
      "type": "number",
      "description": "Longitude coordinate of the destination"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Trip start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Trip end date"
    },
    "trip_status": {
      "type": "string",
      "enum": [
        "planning",
        "confirmed",
        "ongoing",
        "completed",
        "cancelled"
      ],
      "description": "Current status of the trip"
    },
    "total_budget": {
      "type": "number",
      "description": "Total budget in minor currency units (cents)"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code, e.g. USD, EUR"
    },
    "traveler_count": {
      "type": "number",
      "default": 1,
      "description": "Number of travellers on this trip"
    },
    "trip_notes": {
      "type": "string",
      "description": "Free-form notes about the trip"
    },
    "ai_itinerary_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether an AI itinerary has been generated for this trip"
    },
    "trip_created_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trip record was created"
    },
    "trip_updated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the trip record was last updated"
    }
  },
  "required": [
    "id_uuid",
    "user_id",
    "trip_name",
    "destination_city",
    "destination_country",
    "start_date",
    "end_date",
    "trip_status",
    "trip_created_date",
    "trip_updated_date"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}