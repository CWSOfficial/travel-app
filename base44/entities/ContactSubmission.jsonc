{
  "name": "ContactSubmission",
  "description": "Stores user support form submissions from the Help & Support page.",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID if logged in"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "topic": {
      "type": "string",
      "enum": [
        "Account Issue",
        "Billing & Subscription",
        "Technical Problem",
        "Feature Request",
        "Safety Concern",
        "Other"
      ]
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "in_progress",
        "resolved"
      ],
      "default": "new"
    }
  },
  "required": [
    "name",
    "email",
    "topic",
    "message",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}