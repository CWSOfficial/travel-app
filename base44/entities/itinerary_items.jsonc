{
  "name": "itinerary_items",
  "description": "One row per item in an itinerary. Linked to trips and users. Supports AI-generated and manually added items. sort_order + day_number allow precise itinerary reconstruction on export.",
  "type": "object",
  "properties": {
    "id_uuid": {
      "type": "string",
      "description": "Primary key in UUID format"
    },
    "trip_id": {
      "type": "string",
      "description": "Foreign key referencing trips.id"
    },
    "user_id": {
      "type": "string",
      "description": "Foreign key referencing users.id, denormalised for fast queries"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "flight",
        "hotel",
        "activity",
        "restaurant",
        "transport",
        "other"
      ],
      "description": "Category of the itinerary item"
    },
    "title": {
      "type": "string",
      "description": "Short label for the item, e.g. Check-in at Shinjuku Hotel"
    },
    "description": {
      "type": "string",
      "description": "Detailed notes or description for this item"
    },
    "location_name": {
      "type": "string",
      "description": "Name of the location or venue"
    },
    "location_address": {
      "type": "string",
      "description": "Full address of the location"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude coordinate of the location"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude coordinate of the location"
    },
    "start_datetime": {
      "type": "string",
      "format": "date",
      "description": "Start date/time of the item"
    },
    "end_datetime": {
      "type": "string",
      "format": "date",
      "description": "End date/time of the item"
    },
    "day_number": {
      "type": "number",
      "description": "Which day of the trip this item falls on (1, 2, 3...)"
    },
    "sort_order": {
      "type": "number",
      "description": "Ordering position within a day for itinerary reconstruction"
    },
    "booking_reference": {
      "type": "string",
      "description": "Booking confirmation or reference code"
    },
    "booking_status": {
      "type": "string",
      "enum": [
        "unbooked",
        "booked",
        "cancelled"
      ],
      "description": "Current booking status of this item"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Estimated cost in minor currency units (cents)"
    },
    "external_url": {
      "type": "string",
      "description": "Link to booking page or external info resource"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false,
      "description": "Whether this item was generated by AI"
    },
    "item_created_date": {
      "type": "string",
      "format": "date",
      "description": "Date the record was created"
    },
    "item_updated_date": {
      "type": "string",
      "format": "date",
      "description": "Date the record was last updated"
    }
  },
  "required": [
    "id_uuid",
    "trip_id",
    "user_id",
    "item_type",
    "title",
    "item_created_date",
    "item_updated_date"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}